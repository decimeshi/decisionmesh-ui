# .env.e2e — used by Playwright's webServer (see playwright.config.ts) when
# running `vite --mode e2e`. Points auth at the mock-oidc-server container
# instead of real Zitadel Cloud. NEVER used for dev/staging/prod builds.
#
# "mock-oidc" must resolve to 127.0.0.1 on whatever machine runs the browser
# (the CI runner, or your machine if running locally) — see e2e/README.md.
VITE_APP_ENV=e2e
VITE_ZITADEL_AUTHORITY=http://mock-oidc:8080/zitadel
VITE_ZITADEL_CLIENT_ID=e2e-test-client
VITE_ZITADEL_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_ZITADEL_POST_LOGOUT_URI=http://localhost:3000
VITE_ZITADEL_SILENT_REDIRECT_URI=http://localhost:3000/auth/silent-callback
